// Jewellery Manufacturing, Costing & Karigar Management System
// Physical schema derived from BRD Section 10 (Conceptual Data Model) and
// Section 8 functional requirements. Money/metal transactions are treated
// as append-only ledgers per BR-13 (immutability) — corrections are
// reversing entries, never edits.

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ---------------------------------------------------------------------------
// Module 11 — Users, Roles, Audit
// ---------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  MANAGER
  COSTING
  STORE
  PRODUCTION
  SALES
  KARIGAR
  AUDITOR
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  isActive     Boolean  @default(true)
  karigarId    String?  @unique // set only for KARIGAR-role logins
  karigar      Karigar? @relation(fields: [karigarId], references: [id])
  failedLoginCount Int  @default(0)
  lockedUntil  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogs        AuditLog[]
  createdProducts  Product[]        @relation("ProductCreatedBy")
  createdJobCards  JobCard[]        @relation("JobCardCreatedBy")
  issuedMaterials  MaterialIssue[]  @relation("MaterialIssuedBy")
  receivedMaterials MaterialReceipt[] @relation("MaterialReceivedBy")
  enteredLabour    LabourEntry[]    @relation("LabourEnteredBy")
  approvedLabour   LabourEntry[]    @relation("LabourApprovedBy")
  createdEstimates Estimate[]       @relation("EstimateCreatedBy")
  approvedEstimates Estimate[]      @relation("EstimateApprovedBy")
  approvedWastage  WastageRecord[]  @relation("WastageApprovedBy")
  createdOrders    Order[]          @relation("OrderCreatedBy")
  createdAssemblies Assembly[]      @relation("AssemblyCreatedBy")
  qcInspections    QCInspection[]   @relation("QCInspectedBy")
  createdStones    Stone[]          @relation("StoneCreatedBy")
  stoneMovementsCreated StoneMovement[] @relation("StoneMovementCreatedBy")
  notifications    Notification[]
  notificationReads NotificationRead[]
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
}

model AuditLog {
  id         String      @id @default(cuid())
  userId     String?
  user       User?       @relation(fields: [userId], references: [id])
  action     AuditAction
  entityType String
  entityId   String
  beforeJson Json?
  afterJson  Json?
  ipAddress  String?
  createdAt  DateTime    @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Module 1 — Master Data
// ---------------------------------------------------------------------------

model GoldRate {
  id            String   @id @default(cuid())
  ratePerGram24k Decimal @db.Decimal(12, 2)
  effectiveFrom DateTime
  createdById   String?
  createdAt     DateTime @default(now())

  @@index([effectiveFrom])
}

model Karat {
  id            String   @id @default(cuid())
  code          String   @unique // "24K", "22K", "18K", "14K"
  purityFactor  Decimal  @db.Decimal(6, 4) // e.g. 0.7500
  isActive      Boolean  @default(true)

  products      Product[]
  materialIssues MaterialIssue[]
  estimateLines EstimateLine[]
  stockLedgerEntries StockLedgerEntry[]
}

enum StoneCategory {
  POLKI
  DIAMOND
  COLOURED_STONE
}

model StoneType {
  id                  String        @id @default(cuid())
  name                String
  category            StoneCategory
  defaultRatePerCarat Decimal?      @db.Decimal(12, 2)
  isActive            Boolean       @default(true)

  materialIssues   MaterialIssue[]
  estimateLines    EstimateLine[]
  stockLedgerEntries StockLedgerEntry[]
  stones           Stone[]
}

model Category {
  id            String   @id @default(cuid())
  name          String
  code          String   @unique // used in serial number, e.g. "NK"
  isActive      Boolean  @default(true)

  subcategories Subcategory[]
  products      Product[]
}

model Subcategory {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  name       String
  isActive   Boolean  @default(true)

  products   Product[]

  @@unique([categoryId, name])
}

model ProcessStage {
  id                 String   @id @default(cuid())
  name               String   @unique // Casting, Filing, Setting, Polishing, QC...
  sequenceOrder      Int
  wastageTolerancePct Decimal @db.Decimal(5, 2)
  isActive           Boolean  @default(true)

  jobStages          JobStage[]
  karigarRates       KarigarStageRate[]
}

enum EmploymentType {
  IN_HOUSE
  EXTERNAL
}

model Karigar {
  id              String         @id @default(cuid())
  code            String         @unique // KR-014
  name            String
  photoUrl        String?
  contactNumber   String?
  address         String?
  specialization  String?
  employmentType  EmploymentType
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())

  user            User?
  stageRates      KarigarStageRate[]
  jobStages       JobStage[]
  materialIssues  MaterialIssue[]
  materialReceipts MaterialReceipt[]
  labourEntries   LabourEntry[]
  ledgerEntries   KarigarLedgerEntry[]
  assembliesAssembled Assembly[]
  stonesHeld      Stone[]
  stoneMovements  StoneMovement[]

  @@index([isActive])
}

model KarigarStageRate {
  id             String        @id @default(cuid())
  karigarId      String
  karigar        Karigar       @relation(fields: [karigarId], references: [id])
  processStageId String
  processStage   ProcessStage  @relation(fields: [processStageId], references: [id])
  rateBasis      LabourRateBasis
  rate           Decimal       @db.Decimal(12, 2)

  @@unique([karigarId, processStageId])
}

enum LabourRateBasis {
  PER_GRAM
  PER_PIECE
  PER_CARAT
  DAILY_WAGE
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  contact   String?
  address   String?
  isActive  Boolean  @default(true)

  products  Product[]
  jobCards  JobCard[]
  estimates Estimate[]
  ledgerEntries CustomerLedgerEntry[]
  orders    Order[]
}

enum VendorType {
  REFINER
  SUPPLIER
}

model Vendor {
  id       String     @id @default(cuid())
  name     String
  type     VendorType
  contact  String?
  isActive Boolean    @default(true)

  dustLots DustLot[]
  stockLedgerEntries StockLedgerEntry[]
  stones   Stone[]
}

model ChargeType {
  id       String  @id @default(cuid())
  name     String  @unique // Hallmarking, Certification, Packing, Rhodium, Freight
  isActive Boolean @default(true)

  estimateLines EstimateLine[]
}

// ---------------------------------------------------------------------------
// Module 2 — Product & Design Registry
// ---------------------------------------------------------------------------

enum ProductStatus {
  DESIGN
  ESTIMATED
  IN_PRODUCTION
  FINISHED
  SOLD
  MELTED
}

enum DesignSource {
  IN_HOUSE
  CUSTOMER_SUPPLIED
}

model Product {
  id             String        @id @default(cuid())
  serialNo       String        @unique
  legacyRef      String?
  designName     String
  categoryId     String
  category       Category      @relation(fields: [categoryId], references: [id])
  subcategoryId  String?
  subcategory    Subcategory?  @relation(fields: [subcategoryId], references: [id])
  purityId       String
  purity         Karat         @relation(fields: [purityId], references: [id])
  grossWeightG   Decimal       @db.Decimal(10, 3)
  netWeightG     Decimal       @db.Decimal(10, 3)
  stoneWeightCt  Decimal?      @db.Decimal(10, 3)
  size           String?
  description    String?
  designSource   DesignSource  @default(IN_HOUSE)
  customerId     String?
  customer       Customer?     @relation(fields: [customerId], references: [id])
  status         ProductStatus @default(DESIGN)
  clonedFromId   String?

  createdById    String
  createdBy      User          @relation("ProductCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  images         ProductImage[]
  jobCards       JobCard[]
  estimates      Estimate[]
  orders         Order[]

  @@index([status])
  @@index([categoryId, purityId])
}

// Serial number sequence counters, one row per (category, purity, yymm) bucket,
// incremented inside a transaction to guarantee no duplicate/skipped numbers
// under concurrent creation (FR-2.03).
model SerialSequence {
  bucketKey String @id // e.g. "NK-18K-2607"
  lastValue Int    @default(0)
}

enum ImageType {
  SKETCH
  WORK_IN_PROGRESS
  FINAL_PRODUCT
}

model ProductImage {
  id           String    @id @default(cuid())
  productId    String
  product      Product   @relation(fields: [productId], references: [id])
  type         ImageType
  url          String
  thumbnailUrl String?
  isPrimary    Boolean   @default(false)
  isActive     Boolean   @default(true)
  embedding    Unsupported("vector(1024)")?
  uploadedById String?
  createdAt    DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// Module 3 — Job Card & Manufacturing Workflow
// ---------------------------------------------------------------------------

enum JobCardStatus {
  OPEN
  ON_HOLD
  CLOSED
}

model JobCard {
  id                 String        @id @default(cuid())
  productId          String
  product            Product       @relation(fields: [productId], references: [id])
  customerId         String?
  customer           Customer?     @relation(fields: [customerId], references: [id])
  // Which specific quotation/costing this production run belongs to. Product
  // is just the design/catalog item and gets reused across customers, so the
  // thing that isolates one customer's job card (karigars, material issues,
  // labour) from another customer's run on the same design is the Estimate,
  // not the Product.
  estimateId         String?
  estimate           Estimate?     @relation(fields: [estimateId], references: [id])
  // A multi-component order (e.g. a bridal set) has one JobCard per
  // component, all pointing at the same Order — that's what Assembly later
  // gathers back together. Single-piece jobs just leave this null.
  orderId            String?
  order              Order?        @relation(fields: [orderId], references: [id])
  targetDeliveryDate DateTime?
  status             JobCardStatus @default(OPEN)
  holdReason         String?

  createdById        String
  createdBy          User          @relation("JobCardCreatedBy", fields: [createdById], references: [id])
  createdAt          DateTime      @default(now())
  closedAt           DateTime?

  stages             JobStage[]
  assemblyComponents AssemblyComponent[]

  @@index([status])
  @@index([orderId])
  @@index([estimateId])
}

enum JobStageStatus {
  PENDING
  ISSUED
  IN_PROGRESS
  RECEIVED
  APPROVED
  REWORK
}

model JobStage {
  id                   String         @id @default(cuid())
  jobCardId            String
  jobCard              JobCard        @relation(fields: [jobCardId], references: [id])
  processStageId       String
  processStage         ProcessStage   @relation(fields: [processStageId], references: [id])
  karigarId            String?
  karigar              Karigar?       @relation(fields: [karigarId], references: [id])
  sequenceOrder        Int
  status               JobStageStatus @default(PENDING)
  assignedAt           DateTime?
  expectedCompletionAt DateTime?
  isRework             Boolean        @default(false)
  reworkOfStageId       String?

  materialIssues   MaterialIssue[]
  materialReceipts MaterialReceipt[]
  labourEntries    LabourEntry[]
  wastageRecord    WastageRecord?
  stonesCurrentlyHere Stone[]
  stoneMovements   StoneMovement[]

  @@index([jobCardId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Module 4 — Raw Material, Inventory & Metal Accounting
// ---------------------------------------------------------------------------

enum MaterialType {
  GOLD
  POLKI
  COLOURED_STONE
  FINDING
}

model MaterialIssue {
  id            String       @id @default(cuid())
  issueNo       String       @unique
  jobStageId    String
  jobStage      JobStage     @relation(fields: [jobStageId], references: [id])
  karigarId     String
  karigar       Karigar      @relation(fields: [karigarId], references: [id])
  materialType  MaterialType
  purityId      String?
  purity        Karat?       @relation(fields: [purityId], references: [id])
  stoneTypeId   String?
  stoneType     StoneType?   @relation(fields: [stoneTypeId], references: [id])
  grossWeightG  Decimal?     @db.Decimal(10, 3)
  fineWeightG   Decimal      @db.Decimal(10, 3)
  caratWeight   Decimal?     @db.Decimal(10, 3)
  pieces        Int?

  issuedById    String
  issuedBy      User         @relation("MaterialIssuedBy", fields: [issuedById], references: [id])
  issuedAt      DateTime     @default(now())

  isReversed    Boolean      @default(false)
  reversalOfId  String?      @unique

  @@index([jobStageId])
  @@index([karigarId])
}

model MaterialReceipt {
  id                    String   @id @default(cuid())
  receiptNo             String   @unique
  jobStageId            String
  jobStage              JobStage @relation(fields: [jobStageId], references: [id])
  karigarId             String
  karigar               Karigar  @relation(fields: [karigarId], references: [id])
  finishedPieceWeightG  Decimal  @db.Decimal(10, 3)
  // Non-gold material (wax, solder, support wire, etc.) a karigar mixes into
  // the finished piece purely to shape/hold it while working — has zero gold
  // value, so it must be netted out of finishedPieceWeightG before applying
  // the purity factor, or it gets miscounted as fine gold "returned".
  fillerWeightG         Decimal  @db.Decimal(10, 3) @default(0)
  fillerNote            String?
  // When true (the recommended default), (finishedPieceWeightG - fillerWeightG)
  // is already the karigar's declared actual gold content and is credited
  // as-is. When false, that net weight is still raw alloy and gets reduced by
  // the product's purity factor first, same as before this field existed.
  pieceWeightIsFine     Boolean  @default(true)
  dustWeightG           Decimal  @db.Decimal(10, 3) @default(0)
  unusedReturnedWeightG Decimal  @db.Decimal(10, 3) @default(0)
  stonesReturnedJson    Json?

  dustLotId             String?
  dustLot               DustLot? @relation(fields: [dustLotId], references: [id])

  receivedById          String
  receivedBy            User     @relation("MaterialReceivedBy", fields: [receivedById], references: [id])
  receivedAt            DateTime @default(now())

  isReversed            Boolean  @default(false)
  reversalOfId          String?  @unique

  @@index([jobStageId])
  @@index([karigarId])
}

// ---------------------------------------------------------------------------
// Module 5 — Gold Dust, Wastage & Loss Reconciliation
// ---------------------------------------------------------------------------

enum WastageExceptionStatus {
  NONE          // within tolerance, no exception raised
  PENDING
  APPROVED
  REJECTED
}

model WastageRecord {
  id                String                  @id @default(cuid())
  jobStageId        String                  @unique
  jobStage          JobStage                @relation(fields: [jobStageId], references: [id])

  fineIssuedG       Decimal                 @db.Decimal(10, 3)
  finePieceG        Decimal                 @db.Decimal(10, 3)
  fineDustG         Decimal                 @db.Decimal(10, 3)
  fineReturnedG     Decimal                 @db.Decimal(10, 3)
  netWastageG       Decimal                 @db.Decimal(10, 3)
  wastagePct        Decimal                 @db.Decimal(6, 2)
  tolerancePct      Decimal                 @db.Decimal(5, 2)
  withinTolerance   Boolean

  exceptionStatus   WastageExceptionStatus  @default(NONE)
  exceptionReason   String?
  approvedById      String?
  approvedBy        User?                   @relation("WastageApprovedBy", fields: [approvedById], references: [id])
  approvedAt        DateTime?

  recoveredFromKarigar Boolean              @default(false)
  recoveryAmount       Decimal?             @db.Decimal(12, 2)

  createdAt         DateTime                @default(now())

  @@index([exceptionStatus])
}

enum DustLotStatus {
  OPEN
  DESPATCHED
  RECEIVED
}

model DustLot {
  id                 String        @id @default(cuid())
  lotNo              String        @unique
  status             DustLotStatus @default(OPEN)
  totalDustWeightG   Decimal       @db.Decimal(10, 3) @default(0)
  vendorId           String?
  vendor             Vendor?       @relation(fields: [vendorId], references: [id])
  despatchedAt       DateTime?
  recoveredPureGoldG Decimal?      @db.Decimal(10, 3)
  recoveredAt        DateTime?
  recoveryPct        Decimal?      @db.Decimal(6, 2)

  receipts           MaterialReceipt[]

  createdAt          DateTime      @default(now())
}

// ---------------------------------------------------------------------------
// Module 6 — Karigar Labour & Employee Costing
// ---------------------------------------------------------------------------

enum LabourEntryStatus {
  PENDING
  APPROVED
}

model LabourEntry {
  id           String            @id @default(cuid())
  jobStageId   String
  jobStage     JobStage          @relation(fields: [jobStageId], references: [id])
  karigarId    String
  karigar      Karigar           @relation(fields: [karigarId], references: [id])
  rateBasis    LabourRateBasis
  quantity     Decimal           @db.Decimal(10, 3)
  rate         Decimal           @db.Decimal(12, 2)
  amount       Decimal           @db.Decimal(12, 2)
  isOverride   Boolean           @default(false)
  status       LabourEntryStatus @default(PENDING)

  enteredById  String
  enteredBy    User              @relation("LabourEnteredBy", fields: [enteredById], references: [id])
  enteredAt    DateTime          @default(now())
  approvedById String?
  approvedBy   User?             @relation("LabourApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  @@index([karigarId])
  @@index([status])
}

enum KarigarLedgerEntryType {
  METAL_DEBIT
  METAL_CREDIT
  LABOUR_EARNED
  ADVANCE_PAID
  ADVANCE_ADJUSTED
  WASTAGE_RECOVERY
}

model KarigarLedgerEntry {
  id            String                  @id @default(cuid())
  karigarId     String
  karigar       Karigar                 @relation(fields: [karigarId], references: [id])
  type          KarigarLedgerEntryType
  fineGoldG     Decimal?                @db.Decimal(10, 3)
  amount        Decimal?                @db.Decimal(12, 2)
  referenceType String
  referenceId   String
  note          String?
  createdAt     DateTime                @default(now())

  @@index([karigarId, createdAt])
}

// ---------------------------------------------------------------------------
// Module 7 — Costing & Estimate Engine
// ---------------------------------------------------------------------------

enum EstimateType {
  ROUGH_ESTIMATE
  FINAL_COSTING
}

enum EstimateStatus {
  DRAFT
  SUBMITTED
  APPROVED
  SUPERSEDED
}

model Estimate {
  id             String         @id @default(cuid())
  // Trackable document number, assigned once at creation (QT- for a Rough
  // Estimate/quotation, FC- for a Final Costing) — same atomic-sequence
  // pattern as Order.orderNo. Distinct from productId+version, which only
  // says "which revision of this design"; this says "which specific document",
  // since the same product/serial repeats across every quote and revision.
  estimateNo     String?        @unique
  productId      String
  product        Product        @relation(fields: [productId], references: [id])
  // Who this specific estimate is for — stored per-estimate (like JobCard.customerId)
  // rather than on Product, since the same design is re-estimated for different
  // customers over time and Product.customerId must not be overwritten by that.
  customerId     String?
  customer       Customer?      @relation(fields: [customerId], references: [id])
  type           EstimateType
  version        Int
  status         EstimateStatus @default(DRAFT)

  estimateDate       DateTime
  goldRateSnapshot24k Decimal   @db.Decimal(12, 2)
  profitPct          Decimal    @db.Decimal(5, 2)

  materialCost   Decimal        @db.Decimal(12, 2) @default(0)
  makingCharges  Decimal        @db.Decimal(12, 2) @default(0)
  otherCharges   Decimal        @db.Decimal(12, 2) @default(0)
  wastageCost    Decimal        @db.Decimal(12, 2) @default(0)
  cost           Decimal        @db.Decimal(12, 2) @default(0)
  profit         Decimal        @db.Decimal(12, 2) @default(0)
  gstAmount      Decimal        @db.Decimal(12, 2) @default(0)
  netAmount      Decimal        @db.Decimal(12, 2) @default(0)

  showBreakdownOnPdf Boolean    @default(false)
  gstPct             Decimal    @db.Decimal(5, 2) @default(3)

  createdById    String
  createdBy      User           @relation("EstimateCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime       @default(now())
  approvedById   String?
  approvedBy     User?          @relation("EstimateApprovedBy", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  quotationSentAt DateTime?

  lines          EstimateLine[]
  order          Order?
  jobCards       JobCard[]

  @@unique([productId, type, customerId, version])
  @@index([productId])
}

enum EstimateLineHead {
  GOLD
  POLKI
  COLOURED_STONE
  MAKING
  OTHER
  WASTAGE
}

enum EstimateLineSource {
  MANUAL
  FROM_LABOUR
  FROM_WASTAGE
}

model EstimateLine {
  id            String             @id @default(cuid())
  estimateId    String
  estimate      Estimate           @relation(fields: [estimateId], references: [id])
  head          EstimateLineHead
  description   String?
  purityId      String?
  purity        Karat?             @relation(fields: [purityId], references: [id])
  stoneTypeId   String?
  stoneType     StoneType?         @relation(fields: [stoneTypeId], references: [id])
  chargeTypeId  String?
  chargeType    ChargeType?        @relation(fields: [chargeTypeId], references: [id])
  karigarName   String?
  quantity      Decimal            @db.Decimal(10, 3)
  pieces        Int?
  rateBasis     LabourRateBasis?   // POLKI/COLOURED_STONE only — PER_CARAT (default, uses quantity) or PER_PIECE (uses pieces)
  rate          Decimal            @db.Decimal(12, 2)
  amount        Decimal            @db.Decimal(12, 2)
  sourceType    EstimateLineSource @default(MANUAL)
  sourceLabourEntryId String?
  sortOrder     Int                @default(0)

  @@index([estimateId])
}

// ---------------------------------------------------------------------------
// App settings — client-toggleable feature flags (e.g. Store Stock Ledger,
// which the client said is not core to how they work today but should be
// available as an opt-in module without a code change).
// ---------------------------------------------------------------------------

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Store gold / stone stock ledger — optional module (FR-4.05/4.06), gated by
// the "stockLedgerEnabled" AppSetting. Tracks material sitting in the store
// itself, separate from the Karigar metal ledger which tracks material once
// issued out to a karigar. IN entries: purchases, dust-recovery credits,
// unused gold returned by a karigar. OUT entries: issues to a karigar.
// ---------------------------------------------------------------------------

enum StockDirection {
  IN
  OUT
}

model StockLedgerEntry {
  id           String         @id @default(cuid())
  materialType MaterialType
  purityId     String?
  purity       Karat?         @relation(fields: [purityId], references: [id])
  stoneTypeId  String?
  stoneType    StoneType?     @relation(fields: [stoneTypeId], references: [id])
  direction    StockDirection
  quantity     Decimal        @db.Decimal(10, 3) // grams for gold/findings, carats for stones
  vendorId     String?
  vendor       Vendor?        @relation(fields: [vendorId], references: [id])
  rate         Decimal?       @db.Decimal(12, 2) // purchase rate, if applicable
  referenceType String
  referenceId   String
  note          String?
  createdById   String?
  createdAt     DateTime      @default(now())

  @@index([materialType, purityId, stoneTypeId, createdAt])
}

// ---------------------------------------------------------------------------
// Customer ledger — money owed by / advances held from each customer.
// Invoice entries are posted automatically when a Final Costing estimate is
// approved (BR-08 keeps the estimate itself locked; this just mirrors its
// net amount onto the customer's account).
// ---------------------------------------------------------------------------

enum CustomerLedgerEntryType {
  INVOICE_RAISED
  ADVANCE_RECEIVED
  PAYMENT_RECEIVED
  ADJUSTMENT
}

model CustomerLedgerEntry {
  id            String                   @id @default(cuid())
  customerId    String
  customer      Customer                 @relation(fields: [customerId], references: [id])
  type          CustomerLedgerEntryType
  amount        Decimal                  @db.Decimal(12, 2)
  referenceType String
  referenceId   String
  note          String?
  createdById   String?
  createdAt     DateTime                 @default(now())

  @@index([customerId, createdAt])
}

// ---------------------------------------------------------------------------
// Module 12 — Orders. An Order is created explicitly (Convert to Order) from
// an APPROVED Final Costing estimate — it's the commercial commitment that
// then drives everything downstream (material planning, assembly, QC,
// delivery), separate from the estimate itself which stays locked per BR-08.
// ---------------------------------------------------------------------------

enum OrderStatus {
  CONFIRMED
  MATERIAL_PLANNING
  MATERIAL_ISSUED
  IN_PRODUCTION
  MATERIAL_RETURN
  RECONCILIATION
  ASSEMBLY
  QC
  READY
  DELIVERED
}

model Order {
  id                   String      @id @default(cuid())
  orderNo              String      @unique
  productId            String
  product              Product     @relation(fields: [productId], references: [id])
  estimateId           String      @unique
  estimate             Estimate    @relation(fields: [estimateId], references: [id])
  customerId           String
  customer             Customer    @relation(fields: [customerId], references: [id])
  approvedAmount       Decimal     @db.Decimal(12, 2)
  advanceReceived      Decimal     @db.Decimal(12, 2) @default(0)
  status               OrderStatus @default(CONFIRMED)
  expectedDeliveryDate DateTime?
  deliveredAt          DateTime?

  createdById          String
  createdBy            User        @relation("OrderCreatedBy", fields: [createdById], references: [id])
  createdAt            DateTime    @default(now())

  jobCards             JobCard[]
  assemblies           Assembly[]
  qcInspections        QCInspection[]

  @@index([status])
}

// ---------------------------------------------------------------------------
// Module 13 — Assembly. For a multi-component order (e.g. a bridal set with
// separate JobCards for necklace/earrings/bangles), Assembly is where the
// finished components get gathered, checked off, and weighed as one piece
// before QC.
// ---------------------------------------------------------------------------

enum AssemblyStatus {
  PENDING
  IN_ASSEMBLY
  ASSEMBLED
}

model Assembly {
  id           String         @id @default(cuid())
  orderId      String
  order        Order          @relation(fields: [orderId], references: [id])
  assemblerId  String?
  assembler    Karigar?       @relation(fields: [assemblerId], references: [id])
  status       AssemblyStatus @default(PENDING)
  finalWeightG Decimal?       @db.Decimal(10, 3)
  remarks      String?
  startedAt    DateTime?
  completedAt  DateTime?

  createdById  String
  createdBy    User           @relation("AssemblyCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime       @default(now())

  components   AssemblyComponent[]

  @@index([orderId])
}

enum AssemblyComponentStatus {
  PENDING
  COMPLETE
  MISSING
}

model AssemblyComponent {
  id         String                   @id @default(cuid())
  assemblyId String
  assembly   Assembly                 @relation(fields: [assemblyId], references: [id])
  jobCardId  String
  jobCard    JobCard                  @relation(fields: [jobCardId], references: [id])
  status     AssemblyComponentStatus  @default(PENDING)

  @@index([assemblyId])
}

// ---------------------------------------------------------------------------
// Module 14 — Quality Control. One inspection per Order (a failed inspection
// gets re-submitted as a fresh row after rework, keeping the full history —
// never edited in place, matching the append-only pattern used elsewhere).
// ---------------------------------------------------------------------------

enum QCResult {
  PENDING
  PASS
  FAIL
  REWORK_REQUIRED
  APPROVED
}

model QCInspection {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id])
  inspectorId   String
  inspector     User     @relation("QCInspectedBy", fields: [inspectorId], references: [id])
  checklistJson Json?
  result        QCResult @default(PENDING)
  remarks       String?
  inspectedAt   DateTime @default(now())

  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Module 15 — Stone / Diamond / Polki unit-level traceability. StoneType
// (already in Module 1) is a rate/category master; Stone is the individual,
// physically traceable unit — the thing the owner can ask "where is this
// specific diamond right now?" about.
// ---------------------------------------------------------------------------

enum StoneStatus {
  IN_STOCK
  ISSUED
  RETURNED
  SET
  SOLD
}

model Stone {
  id                String      @id @default(cuid())
  stoneCode         String      @unique
  stoneTypeId       String
  stoneType         StoneType   @relation(fields: [stoneTypeId], references: [id])
  shape             String?
  caratWeight       Decimal     @db.Decimal(10, 3)
  colour            String?
  clarity           String?
  certification     String?
  purchaseCost      Decimal?    @db.Decimal(12, 2)
  vendorId          String?
  vendor            Vendor?     @relation(fields: [vendorId], references: [id])
  status            StoneStatus @default(IN_STOCK)
  currentJobStageId String?
  currentJobStage   JobStage?   @relation(fields: [currentJobStageId], references: [id])
  currentKarigarId  String?
  currentKarigar    Karigar?    @relation(fields: [currentKarigarId], references: [id])

  createdById       String
  createdBy         User        @relation("StoneCreatedBy", fields: [createdById], references: [id])
  createdAt         DateTime    @default(now())

  movements         StoneMovement[]

  @@index([status])
  @@index([stoneTypeId])
}

enum StoneMovementType {
  PURCHASE
  ISSUE
  RETURN
  SET
  ADJUSTMENT
}

model StoneMovement {
  id          String            @id @default(cuid())
  stoneId     String
  stone       Stone             @relation(fields: [stoneId], references: [id])
  type        StoneMovementType
  jobStageId  String?
  jobStage    JobStage?         @relation(fields: [jobStageId], references: [id])
  karigarId   String?
  karigar     Karigar?          @relation(fields: [karigarId], references: [id])
  note        String?

  createdById String
  createdBy   User              @relation("StoneMovementCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime          @default(now())

  @@index([stoneId, createdAt])
}

// ---------------------------------------------------------------------------
// Module 16 — Notifications. userId set = targeted at one person; role set
// (userId null) = broadcast to everyone with that role. Read state is
// per-recipient, so a broadcast is marked read only for the user who opened
// it, not for everyone it was sent to.
// ---------------------------------------------------------------------------

model Notification {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  role       Role?
  type       String
  title      String
  body       String?
  entityType String?
  entityId   String?
  // Only meaningful for a targeted notification (userId set). A broadcast's
  // read state is per-recipient and lives in NotificationRead instead —
  // this field stays false on broadcast rows forever.
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  reads      NotificationRead[]

  @@index([userId, isRead])
  @@index([role, isRead])
}

// Per-user read receipts for broadcast notifications (Notification.userId
// null). A targeted notification just flips Notification.isRead directly;
// a broadcast is read by one recipient at a time without affecting whether
// anyone else has seen it, so that state can't live on the Notification row
// itself.
model NotificationRead {
  id             String       @id @default(cuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  readAt         DateTime     @default(now())

  @@unique([notificationId, userId])
}
